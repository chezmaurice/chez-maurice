<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed, as every Mac App Store extension is. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The group whose keychain holds the session the app publishes
	     (Shared/BrowserSession.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.eu.chezmaurice.maurice</string>
	</array>
</dict>
</plist>
